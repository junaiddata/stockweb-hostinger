# VPS Sync - API via SSH tunnel (Office PC runs: ssh -N -R 8443:192.168.1.103:80 user@VPS_IP)
# Copy to .env and adjust values

# Base URL when VPS reaches API through tunnel (localhost:8443 on VPS = PC's API)
API_BASE_HOST=http://localhost:8443

# Or use full URL override:
# API_BASE_URL=http://localhost:8443/IntegrationApi/api/Stock

# Timeout for API requests (seconds). Sync can be slow; 60+ recommended.
API_TIMEOUT=60
